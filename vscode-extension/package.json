{
  "name": "indexqube",
  "displayName": "IndexQube",
  "description": "MAANG-level AI Inference Gateway & Context Optimizer",
  "version": "0.1.0",
  "publisher": "revanth",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:indexqube.chatView",
    "onCommand:indexqube.openChat",
    "onCommand:indexqube.openSettings",
    "onCommand:indexqube.setProviderKey",
    "onCommand:indexqube.checkGateway",
    "onCommand:indexqube.resetSession"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "indexqube-sidebar",
          "title": "IndexQube",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "indexqube-sidebar": [
        {
          "id": "indexqube.chatView",
          "type": "webview",
          "name": "IndexQube Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "indexqube.openChat",
        "title": "IndexQube: Open Chat"
      },
      {
        "command": "indexqube.openSettings",
        "title": "IndexQube: Open Settings"
      },
      {
        "command": "indexqube.setProviderKey",
        "title": "IndexQube: Set Provider Key"
      },
      {
        "command": "indexqube.checkGateway",
        "title": "IndexQube: Check Gateway"
      },
      {
        "command": "indexqube.resetSession",
        "title": "IndexQube: Reset Workspace Session"
      }
    ],
    "configuration": {
      "title": "IndexQube",
      "properties": {
        "indexqube.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of your IndexQube Gateway."
        },
        "indexqube.provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "azure", "bedrock"],
          "default": "anthropic",
          "description": "The LLM provider to use."
        },
        "indexqube.model": {
          "type": "string",
          "default": "claude-3-5-sonnet",
          "description": "The model ID to use."
        },
        "indexqube.contextMode": {
          "type": "string",
          "enum": ["selection", "activeFile", "openEditors", "workspace"],
          "default": "activeFile",
          "description": "Default editor context included with each request."
        },
        "indexqube.memoryMode": {
          "type": "string",
          "enum": ["workspace", "isolated"],
          "default": "workspace",
          "description": "Controls optimizer session reuse. Workspace reuses one session for dedupe; isolated uses a fresh session key per request."
        },
        "indexqube.privacyMode": {
          "type": "string",
          "enum": ["standard", "localOnly"],
          "default": "standard",
          "description": "standard: allows HTTPS remote gateways and localhost. localOnly: restricts to localhost/127.0.0.1/::1 only — remote HTTPS gateways are also blocked."
        },
        "indexqube.contextExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional file path patterns excluded from IndexQube context. Supports * wildcards."
        },
        "indexqube.maxContextBytes": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Maximum total context bytes sent to the gateway."
        },
        "indexqube.maxFileBytes": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Maximum bytes included from any one file."
        },
        "indexqube.maxWorkspaceFiles": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Maximum files sampled in workspace context mode."
        },
        "indexqube.projectMemory": {
          "type": "string",
          "default": "",
          "description": "Optional project memory sent as IndexQube system context."
        },
        "indexqube.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 1,
          "description": "Maximum output tokens requested from the provider."
        },
        "indexqube.temperature": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature sent to the provider."
        },
        "indexqube.azureEndpoint": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI endpoint used when provider is azure."
        },
        "indexqube.awsRegion": {
          "type": "string",
          "default": "us-east-1",
          "description": "AWS region used when provider is bedrock."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1"
  }
}

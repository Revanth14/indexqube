# Required: dev|production. In production, SUPABASE_DB_URL must also be set.
INDEXQUBE_ENV=dev

# Bind address for the gateway. Caddy reverse-proxies to this.
INDEXQUBE_BIND_ADDR=127.0.0.1:8080

# observe | dry_run | optimize
INDEXQUBE_MODE=observe

INDEXQUBE_DEV_TOKEN=iq-dev-local

ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# debug | info | warn | error
INDEXQUBE_LOG_LEVEL=info

# Inbound prompt cap. Keep aligned with Caddy's `request_body max_size`.
INDEXQUBE_MAX_BODY_BYTES=20000000

INDEXQUBE_SESSION_TTL_MINUTES=240

INDEXQUBE_ENABLE_LOG_PRUNER=false

# This flag also disables Governor.PruneEnabled (same env var is read in two
# places). Set to true to enable both the Path-B block optimizer and the
# governor's code-block diff pruning.
INDEXQUBE_ENABLE_BLOCK_OPTIMIZER=false

# After an upstream 429, short-circuit the same provider/model locally for this
# duration unless Anthropic sends a Retry-After header. This prevents Claude
# Code retry bursts from hammering the provider with huge repeated payloads.
INDEXQUBE_RATE_LIMIT_COOLDOWN=30s

# --- AWS Bedrock backend (replaces direct Anthropic API calls for /v1/messages) ---
# Set INDEXQUBE_BEDROCK_ENABLED=true to route /v1/messages through Bedrock instead.
# Credentials come from the standard AWS SDK chain: env vars (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN), ~/.aws/credentials, or IAM role.
# ANTHROPIC_API_KEY is not required when Bedrock is enabled.
#
# INDEXQUBE_BEDROCK_ENABLED=false
# INDEXQUBE_BEDROCK_REGION=us-east-1
# INDEXQUBE_BEDROCK_MODEL_PREFIX=us.    # "us." for cross-region, "" for single-region
# INDEXQUBE_BEDROCK_MODEL_OVERRIDE=     # force a specific Bedrock model ID for all requests

# --- Optimizer tuning (all have safe defaults; override only if needed) ---
# INDEXQUBE_OPT_MIN_SPAN_BYTES=512          # skip spans smaller than this
# INDEXQUBE_OPT_TARGET_CHUNK_BYTES=2048     # target rewrite chunk size
# INDEXQUBE_OPT_MAX_CHUNK_BYTES=8192        # max rewrite chunk size
# INDEXQUBE_OPT_MIN_SAVED_TOKENS=10         # skip rewrite if savings < this
# INDEXQUBE_OPT_ENABLE_TOOL_RESULT_PRUNING=true   # prune old tool_result spans
# INDEXQUBE_OPT_ENABLE_ASSISTANT_PRUNING=false    # prune old assistant text (aggressive)
# INDEXQUBE_OPT_ENABLE_SYSTEM_PRUNING=true        # prune repeated system text (on by default)
# INDEXQUBE_OPT_DIAGNOSTICS=false                 # verbose per-class logs

# Cap on /v1/optimize (Path A). Streaming requests are unaffected.
# GOVERNOR_OPTIMIZE_TIMEOUT=30s

# Admin server bind. Defaults to 127.0.0.1 so /metrics, /healthz, /readyz
# aren't reachable from outside the host. Set to 0.0.0.0 only when an
# in-cluster scrape target needs direct access.
# ADMIN_BIND_ADDR=127.0.0.1

# --- Supabase usage telemetry (inserts per-request token stats) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# IQ_TELEMETRY=off   # set to "off" to disable telemetry entirely

# --- Production-readiness knobs (uncomment and set in production) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
# OTEL_EXPORTER_OTLP_INSECURE=false
# METRICS_ENABLED=true
# CORS_ALLOWED_ORIGINS=https://app.indexqube.com
# CORS_ALLOW_CHROME_EXTENSIONS=false
# SUPABASE_DB_URL=postgres://...    # response cache (pgvector), different from SUPABASE_URL
